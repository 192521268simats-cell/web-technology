<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Scientific Calculator</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial,sans-serif;
    background:linear-gradient(135deg,#667eea,#764ba2);
    min-height:100vh;
}

/* Navigation */

nav{
    background:white;
    padding:18px 8%;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

nav h2{
    color:#5b21b6;
}

nav ul{
    display:flex;
    gap:25px;
    list-style:none;
}

nav a{
    text-decoration:none;
    color:#333;
    font-weight:bold;
}

/* Calculator */

.container{
    width:90%;
    max-width:420px;
    margin:45px auto;
}

.calculator{
    background:white;
    padding:25px;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,.3);
}

.calculator h1{
    text-align:center;
    color:#4c1d95;
    margin-bottom:20px;
}

#display{
    width:100%;
    height:65px;
    border:2px solid #ddd;
    border-radius:10px;
    margin-bottom:15px;
    padding:10px;
    font-size:25px;
    text-align:right;
}

.buttons{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

button{
    padding:18px;
    border:none;
    border-radius:10px;
    font-size:17px;
    cursor:pointer;
    background:#eee;
}

button:hover{
    background:#ddd;
}

.operator{
    background:#667eea;
    color:white;
}

.special{
    background:#5b21b6;
    color:white;
}

.equal{
    background:#16a34a;
    color:white;
}

.clear{
    background:#dc2626;
    color:white;
}

footer{
    background:white;
    text-align:center;
    padding:18px;
}

@media(max-width:500px){
    nav{
        flex-direction:column;
        gap:15px;
    }
}
</style>
</head>

<body>

<nav>
<h2>Student Portal</h2>

<ul>
<li><a href="#">Home</a></li>
<li><a href="#">Calculator</a></li>
</ul>
</nav>

<div class="container">

<div class="calculator">

<h1>Scientific Calculator</h1>

<input type="text" id="display" readonly>

<div class="buttons">

<button class="clear" onclick="clearDisplay()">C</button>
<button onclick="deleteLast()">DEL</button>
<button class="special" onclick="squareRoot()">√</button>
<button class="operator" onclick="add('/')">÷</button>

<button onclick="add('7')">7</button>
<button onclick="add('8')">8</button>
<button onclick="add('9')">9</button>
<button class="operator" onclick="add('*')">×</button>

<button onclick="add('4')">4</button>
<button onclick="add('5')">5</button>
<button onclick="add('6')">6</button>
<button class="operator" onclick="add('-')">−</button>

<button onclick="add('1')">1</button>
<button onclick="add('2')">2</button>
<button onclick="add('3')">3</button>
<button class="operator" onclick="add('+')">+</button>

<button onclick="add('0')">0</button>
<button onclick="add('.')">.</button>
<button class="special" onclick="square()">x²</button>
<button class="equal" onclick="calculate()">=</button>

</div>

</div>
</div>

<footer>
© 2026 Student Portal | Scientific Calculator
</footer>

<script>

let display=document.getElementById("display");

function add(value){
    display.value+=value;
}

function clearDisplay(){
    display.value="";
}

function deleteLast(){
    display.value=display.value.slice(0,-1);
}

function calculate(){

    try{
        display.value=eval(display.value);
    }
    catch{
        display.value="Error";
    }

}

function squareRoot(){

    let value=Number(display.value);

    if(value>=0){
        display.value=Math.sqrt(value);
    }
    else{
        display.value="Error";
    }

}

function square(){

    let value=Number(display.value);

    display.value=Math.pow(value,2);

}

</script>

</body>
</html>
