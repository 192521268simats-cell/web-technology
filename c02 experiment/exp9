<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Shopping Cart</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial,sans-serif;
    background:linear-gradient(135deg,#667eea,#764ba2);
    min-height:100vh;
}

nav{
    background:white;
    padding:18px 8%;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

nav h2{
    color:#5b21b6;
}

nav ul{
    display:flex;
    gap:25px;
    list-style:none;
}

nav a{
    text-decoration:none;
    color:#333;
    font-weight:bold;
}

.container{
    width:90%;
    max-width:950px;
    margin:40px auto;
}

.card{
    background:white;
    padding:30px;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,.25);
    margin-bottom:25px;
}

h1,h2{
    color:#4c1d95;
    margin-bottom:20px;
}

.product-form{
    display:grid;
    grid-template-columns:2fr 1fr 1fr auto;
    gap:10px;
}

input{
    padding:12px;
    border:2px solid #ddd;
    border-radius:8px;
}

button{
    padding:12px 18px;
    border:none;
    border-radius:8px;
    background:#5b21b6;
    color:white;
    cursor:pointer;
}

button:hover{
    background:#7c3aed;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:12px;
    border:1px solid #ddd;
    text-align:center;
}

th{
    background:#667eea;
    color:white;
}

.delete{
    background:#dc2626;
}

.summary{
    max-width:400px;
    margin-left:auto;
    margin-top:20px;
}

.summary p{
    padding:10px;
    border-bottom:1px solid #ddd;
    display:flex;
    justify-content:space-between;
}

.total{
    font-size:20px;
    font-weight:bold;
    color:#4c1d95;
}

.discount{
    margin-top:20px;
    display:flex;
    gap:10px;
}

.discount input{
    flex:1;
}

footer{
    background:white;
    text-align:center;
    padding:18px;
}

@media(max-width:700px){

    nav{
        flex-direction:column;
        gap:15px;
    }

    .product-form{
        grid-template-columns:1fr;
    }

    table{
        font-size:13px;
    }

}

</style>

</head>

<body>

<nav>

<h2>Student Store</h2>

<ul>
<li><a href="#">Home</a></li>
<li><a href="#">Products</a></li>
<li><a href="#">Cart</a></li>
</ul>

</nav>

<div class="container">

<!-- Product Form -->

<div class="card">

<h1>Add Product</h1>

<div class="product-form">

<input
id="productName"
placeholder="Product Name"
>

<input
id="price"
type="number"
placeholder="Price"
>

<input
id="quantity"
type="number"
placeholder="Quantity"
value="1"
min="1"
>

<button onclick="addProduct()">
Add
</button>

</div>

</div>


<!-- Cart -->

<div class="card">

<h2>Shopping Cart</h2>

<table>

<thead>

<tr>
<th>Product</th>
<th>Price</th>
<th>Quantity</th>
<th>Total</th>
<th>Action</th>
</tr>

</thead>

<tbody id="cartBody">

</tbody>

</table>


<div class="discount">

<input
id="discountCode"
placeholder="Enter discount code"
>

<button onclick="applyDiscount()">
Apply Discount
</button>

</div>


<div class="summary">

<p>
<span>Subtotal</span>
<span id="subtotal">₹0.00</span>
</p>

<p>
<span>Discount</span>
<span id="discount">₹0.00</span>
</p>

<p>
<span>Tax (18%)</span>
<span id="tax">₹0.00</span>
</p>

<p class="total">
<span>Total</span>
<span id="total">₹0.00</span>
</p>

</div>

</div>

</div>

<footer>
© 2026 Student Store | Billing System
</footer>

<script>

let cart = [];

let discountRate = 0;


/* Add Product */

function addProduct(){

    let name =
    document.getElementById("productName").value.trim();

    let price =
    Number(document.getElementById("price").value);

    let quantity =
    Number(document.getElementById("quantity").value);

    if(name === "" || price <= 0 || quantity <= 0){

        alert("Please enter valid product details");

        return;

    }

    let product = {

        name:name,
        price:price,
        quantity:quantity

    };

    cart.push(product);

    document.getElementById("productName").value="";
    document.getElementById("price").value="";
    document.getElementById("quantity").value=1;

    displayCart();

}


/* Display Cart */

function displayCart(){

    let body =
    document.getElementById("cartBody");

    body.innerHTML="";

    cart.forEach(function(product,index){

        let row =
        document.createElement("tr");

        let itemTotal =
        product.price * product.quantity;

        row.innerHTML=`

        <td>${product.name}</td>

        <td>₹${product.price.toFixed(2)}</td>

        <td>
        ${product.quantity}
        </td>

        <td>
        ₹${itemTotal.toFixed(2)}
        </td>

        <td>

        <button
        class="delete"
        onclick="removeProduct(${index})">

        Delete

        </button>

        </td>

        `;

        body.appendChild(row);

    });

    calculateBill();

}


/* Delete */

function removeProduct(index){

    cart.splice(index,1);

    displayCart();

}


/* Discount */

function applyDiscount(){

    let code =
    document.getElementById("discountCode")
    .value.trim()
    .toUpperCase();

    if(code === "SAVE10"){

        discountRate = 0.10;

        alert("10% Discount Applied");

    }
    else{

        discountRate=0;

        alert("Invalid discount code");

    }

    calculateBill();

}


/* Billing */

function calculateBill(){

    let subtotal=0;

    cart.forEach(function(product){

        subtotal +=
        product.price * product.quantity;

    });

    let discount =
    subtotal * discountRate;

    let afterDiscount =
    subtotal - discount;

    let tax =
    afterDiscount * 0.18;

    let total =
    afterDiscount + tax;

    document.getElementById("subtotal").innerText =
    "₹"+subtotal.toFixed(2);

    document.getElementById("discount").innerText =
    "₹"+discount.toFixed(2);

    document.getElementById("tax").innerText =
    "₹"+tax.toFixed(2);

    document.getElementById("total").innerText =
    "₹"+total.toFixed(2);

}

</script>

</body>
</html>
